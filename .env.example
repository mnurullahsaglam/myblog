APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

# Reaches every area of /admin, whatever the role column says.
ADMIN_EMAIL=

# Shown as the panel account's display name.
ADMIN_NAME=

# Optional. A second account with access to Budget, Library and Utilities only.
MEMBER_EMAIL=

# Shown as the member account's display name.
MEMBER_NAME=

# Optional. Sent in the User-Agent to Open Library; defaults to ADMIN_EMAIL.
OPEN_LIBRARY_CONTACT=

# Optional. Without it, task-to-issue syncing is skipped and logged.
GITHUB_TOKEN=

# Optional. Used by GitHubService for the REST API.
GITHUB_PERSONAL_ACCESS_TOKEN=

# Optional. Without these the WakaTime OAuth connect flow cannot start.
WAKATIME_APP_ID=
WAKATIME_APP_SECRET=
WAKATIME_REDIRECT_URI=

# Optional. Currency conversion falls back to stored rates without them.
OPEN_EXCHANGE_RATES_API_KEY=
METALS_API_KEY=

# Optional. Defaults to APP_KEY when unset.
PASSKEYS_USER_HANDLE_SECRET=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Local. Mailtrap's sandbox catches everything over plain SMTP, so nothing
# written while developing can reach a real person and no SDK is needed.
MAIL_MAILER=smtp
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=null

# Production. Set MAIL_MAILER=resend and fill this in; the Mailtrap lines above
# are then ignored.
RESEND_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
